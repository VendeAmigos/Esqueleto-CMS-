---
// apps/storefront/src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import {
  db,
  products,
  categories,
  productModifiers,
  modifierOptions,
  siteSettings,
  eq,
  ensureSchema,
  isDatabaseAvailable,
} from '@esqueleto/core';

// 0. Fallback inmediato con temática de Merch de Ilustradora
const defaultSettings = {
  siteName: 'LUNA ART STUDIO',
  logoColor: '#ec4899',
  heroTitle: 'Ilustración de Autor, Prints & Merch Exclusivo',
  heroSubtitle: 'Láminas de arte fine art, stickers holográficos, pines esmaltados y papelería ilustrada para alegrar tu día a día.',
  heroImageUrl: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=1600&auto=format&fit=crop&q=80',
  heroCtaText: 'Explorar Tienda de Arte',
  heroCtaLink: '/catalogo',
};

const defaultCategories = [
  {
    id: 'cat-prints-01',
    name: 'Prints & Láminas de Arte',
    slug: 'prints-arte',
    imageUrl: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=900&auto=format&fit=crop&q=80',
    gridSpan: '2x2',
    displayOrder: 1,
    productCount: 4,
  },
  {
    id: 'cat-stickers-02',
    name: 'Stickers & Papelería',
    slug: 'stickers-papeleria',
    imageUrl: 'https://images.unsplash.com/photo-1589998059171-988d887df646?w=900&auto=format&fit=crop&q=80',
    gridSpan: '2x1',
    displayOrder: 2,
    productCount: 6,
  },
  {
    id: 'cat-acc-03',
    name: 'Pines & Llaveros Acrílicos',
    slug: 'pines-llaveros',
    imageUrl: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=900&auto=format&fit=crop&q=80',
    gridSpan: '1x2',
    displayOrder: 3,
    productCount: 3,
  },
  {
    id: 'cat-textil-04',
    name: 'Merch Textil & Totebags',
    slug: 'merch-textil',
    imageUrl: 'https://images.unsplash.com/photo-1544816155-12df9643f363?w=900&auto=format&fit=crop&q=80',
    gridSpan: '2x1',
    displayOrder: 4,
    productCount: 2,
  },
  {
    id: 'cat-orig-05',
    name: 'Obras Originales & Libretas',
    slug: 'obras-originales',
    imageUrl: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=900&auto=format&fit=crop&q=80',
    gridSpan: '1x1',
    displayOrder: 5,
    productCount: 1,
  },
];

const defaultFeaturedProducts = [
  {
    id: 'prod-print-jardin',
    title: 'Print Fine Art "El Jardín de los Recuerdos"',
    description: 'Lámina de ilustración impresa en papel algodón de 310g con tintas pigmentadas de archivo. Colores vibrantes de larga duración.',
    imageUrl: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=800&auto=format&fit=crop&q=80',
    basePrice: 18000,
    categoryName: 'Prints & Láminas de Arte',
    modifiers: [
      {
        id: 'mod-size-01',
        name: 'Tamaño de Lámina',
        type: 'single' as const,
        required: true,
        options: [
          { id: 'opt-a5', name: 'A5 (14.8 x 21 cm)', priceDelta: 0, isDefault: true },
          { id: 'opt-a4', name: 'A4 (21 x 29.7 cm)', priceDelta: 6000, isDefault: false },
          { id: 'opt-a3', name: 'A3 (29.7 x 42 cm)', priceDelta: 14000, isDefault: false },
        ],
      },
    ],
  },
  {
    id: 'prod-pack-stickers-brujitas',
    title: 'Pack de Stickers Holográficos "Pequeñas Brujas"',
    description: 'Set de 5 stickers resistentes al agua y al sol con acabado holográfico brillante arcoíris. Ideales para laptop, termo o libreta.',
    imageUrl: 'https://images.unsplash.com/photo-1589998059171-988d887df646?w=800&auto=format&fit=crop&q=80',
    basePrice: 12000,
    categoryName: 'Stickers & Papelería',
    modifiers: [],
  },
  {
    id: 'prod-pin-gato-astral',
    title: 'Pin Metálico Esmaltado "Gato Cósmico"',
    description: 'Pin de metal dorado con esmalte duro pulido (hard enamel) y cierre de goma doble para mayor seguridad.',
    imageUrl: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&auto=format&fit=crop&q=80',
    basePrice: 15000,
    categoryName: 'Pines & Llaveros Acrílicos',
    modifiers: [],
  },
  {
    id: 'prod-totebag-flora',
    title: 'Totebag 100% Algodón Pesado "Flora & Fauna"',
    description: 'Bolsa de tela resistente de 280g/m² serigrafiada a 3 tintas con asas reforzadas para libros o compras.',
    imageUrl: 'https://images.unsplash.com/photo-1544816155-12df9643f363?w=800&auto=format&fit=crop&q=80',
    basePrice: 28000,
    categoryName: 'Merch Textil & Totebags',
    modifiers: [],
  },
];

let settings = { ...defaultSettings };
let categoriesWithCount = [...defaultCategories];
let featuredProducts = [...defaultFeaturedProducts];

// 1. Comprobación rápida del estado de PostgreSQL (Circuit Breaker)
const isDbOnline = await isDatabaseAvailable();

if (isDbOnline) {
  try {
    await ensureSchema();

    // Cargar apariencia en vivo desde la base de datos
    const settingsList = await db.select().from(siteSettings).where(eq(siteSettings.id, 'default')).execute();
    if (settingsList && settingsList[0]) {
      settings = {
        siteName: settingsList[0].siteName || settings.siteName,
        logoColor: settingsList[0].logoColor || settings.logoColor,
        heroTitle: settingsList[0].heroTitle || settings.heroTitle,
        heroSubtitle: settingsList[0].heroSubtitle || settings.heroSubtitle,
        heroImageUrl: settingsList[0].heroImageUrl || settings.heroImageUrl,
        heroCtaText: settingsList[0].heroCtaText || settings.heroCtaText,
        heroCtaLink: settingsList[0].heroCtaLink || settings.heroCtaLink,
      };
    }

    // Cargar categorías y conteos
    const dbCats = await db.select().from(categories).orderBy(categories.displayOrder).execute();
    if (dbCats && dbCats.length > 0) {
      const allActiveProducts = await db
        .select({ id: products.id, categoryId: products.categoryId })
        .from(products)
        .where(eq(products.isActive, true))
        .execute();

      categoriesWithCount = dbCats.map((cat) => ({
        ...cat,
        productCount: allActiveProducts.filter((p) => p.categoryId === cat.id).length,
      }));
    }

    // Cargar productos destacados
    const featuredRaw = await db
      .select({
        id: products.id,
        title: products.title,
        description: products.description,
        imageUrl: products.imageUrl,
        basePrice: products.basePrice,
        isFeatured: products.isFeatured,
        categoryName: categories.name,
      })
      .from(products)
      .leftJoin(categories, eq(products.categoryId, categories.id))
      .where(eq(products.isActive, true))
      .execute();

    if (featuredRaw && featuredRaw.length > 0) {
      const selected = featuredRaw.filter((p) => p.isFeatured);
      const targetList = selected.length > 0 ? selected : featuredRaw.slice(0, 4);

      const allModifiers = await db.select().from(productModifiers).execute();
      const allOptions = await db.select().from(modifierOptions).execute();

      featuredProducts = targetList.map((prod) => {
        const prodMods = allModifiers
          .filter((m) => m.productId === prod.id)
          .map((mod) => ({
            id: mod.id,
            name: mod.name,
            type: mod.type as 'single' | 'multiple',
            required: mod.required,
            options: allOptions
              .filter((o) => o.modifierId === mod.id)
              .map((o) => ({
                id: o.id,
                name: o.name,
                priceDelta: o.priceDelta,
                isDefault: o.isDefault,
              })),
          }));

        return {
          ...prod,
          modifiers: prodMods,
        };
      });
    }
  } catch (err) {
    console.warn('Aviso al consultar PostgreSQL en vivo, usando datos precargados:', err);
  }
}

// Helper de clases para cualquier tamaño de Bento Grid
import { getGridSpanClasses } from '@esqueleto/core';
const getGridSpanClass = (span: string) => getGridSpanClasses(span);
---

<Layout title="Inicio" description={settings.heroSubtitle}>
  <div class="space-y-16">
    
    <!-- 1. BANNER HERO PRINCIPAL (EDITABLE DESDE EL CMS) -->
    <section class="relative isolate overflow-hidden rounded-3xl bg-gray-950 py-20 sm:py-32 shadow-2xl text-center">
      {settings.heroImageUrl && (
        <img
          src={settings.heroImageUrl}
          alt={settings.heroTitle}
          class="absolute inset-0 -z-10 h-full w-full object-cover object-center brightness-75 scale-100 transition-transform duration-1000"
        />
      )}
      <!-- Gradiente oscuro y viñeta para legibilidad óptima -->
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-gray-950 via-gray-950/60 to-gray-950/30 backdrop-blur-[1px]" />

      <div class="mx-auto max-w-3xl px-6 lg:px-8">
        <span
          class="inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-xs font-semibold ring-1 ring-inset mb-6 backdrop-blur-md"
          style={`background-color: ${settings.logoColor}25; color: ${settings.logoColor}; border-color: ${settings.logoColor}55;`}
        >
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style={`background-color: ${settings.logoColor};`} />
          {settings.siteName} • Catálogo Oficial
        </span>

        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl drop-shadow-md">
          {settings.heroTitle}
        </h1>

        <p class="mt-6 text-lg sm:text-xl leading-8 text-gray-200 drop-shadow max-w-2xl mx-auto font-light">
          {settings.heroSubtitle}
        </p>

        <div class="mt-10 flex items-center justify-center gap-x-4">
          <a
            href={settings.heroCtaLink}
            class="rounded-xl px-8 py-4 text-base font-bold text-white shadow-xl transition-all duration-200 hover:scale-105 active:scale-95"
            style={`background-color: ${settings.logoColor};`}
          >
            {settings.heroCtaText} &rarr;
          </a>
          <a
            href="/categorias"
            class="rounded-xl px-6 py-4 text-base font-semibold text-white/90 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 transition-all hover:scale-105"
          >
            Ver Categorías
          </a>
        </div>
      </div>
    </section>

    <!-- 2. BENTO GRID DE CATEGORÍAS (LAYOUT DINÁMICO EDITABLE DESDE EL CMS) -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-gray-200 pb-4 gap-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-md">
            Colecciones
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 mt-1">
            Explora por Categorías
          </h2>
          <p class="text-sm text-gray-500">
            Descubre nuestra variedad de productos clasificados para ti.
          </p>
        </div>
        <a
          href="/categorias"
          class="text-sm font-bold text-gray-900 hover:text-indigo-600 transition-colors inline-flex items-center gap-1 group"
        >
          Ver todas las categorías <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>

      <!-- Bento Grid Container -->
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-5 auto-rows-[240px]">
        {categoriesWithCount.map((cat) => (
          <a
            href={`/categorias/${cat.slug}`}
            class={`group relative rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col justify-end p-6 border border-gray-200/80 ${getGridSpanClass(
              cat.gridSpan
            )}`}
          >
            <!-- Imagen con efecto hover zoom -->
            {cat.imageUrl ? (
              <img
                src={cat.imageUrl}
                alt={cat.name}
                class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
              />
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-950" />
            )}

            <!-- Gradiente oscuro para texto -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent transition-opacity group-hover:via-black/50" />

            <!-- Badge Superior: Contador de Productos -->
            <div class="relative z-10 self-start mb-auto">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-black/60 text-white/90 backdrop-blur-md border border-white/20">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                {cat.productCount} {cat.productCount === 1 ? 'producto' : 'productos'}
              </span>
            </div>

            <!-- Título y Enlace -->
            <div class="relative z-10 space-y-1">
              <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight drop-shadow-md">
                {cat.name}
              </h3>
              <p class="text-xs text-white/80 font-medium inline-flex items-center gap-1 transition-transform group-hover:translate-x-1">
                Explorar productos &rarr;
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 3. SECCIÓN DE PRODUCTOS DESTACADOS (CMS MANAGED) -->
    <section class="space-y-6 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-gray-200 pb-4 gap-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-700" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            Lo más destacado
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 mt-1">
            Productos Destacados
          </h2>
          <p class="text-sm text-gray-500">
            Nuestros artículos más populares con opciones personalizables y entrega rápida.
          </p>
        </div>
        <a
          href="/catalogo"
          class="text-sm font-bold text-gray-900 hover:text-indigo-600 transition-colors inline-flex items-center gap-1 group"
        >
          Ver catálogo completo <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>

      <!-- Grid de Productos Destacados -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard
            id={product.id}
            name={product.title}
            price={product.basePrice}
            image={product.imageUrl || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop&q=80'}
            category={product.categoryName || 'Destacado'}
            description={product.description || ''}
            modifiers={product.modifiers}
          />
        ))}
      </div>
    </section>

    <!-- 4. BENEFICIOS Y CONFIANZA -->
    <section class="border-t border-gray-200/80 pt-12 pb-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center sm:text-left">
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base">Pagos 100% Protegidos</h4>
            <p class="text-xs text-gray-500 mt-1">
              Checkout Pro con Mercado Pago, tarjetas de crédito/débito y transferencias seguras.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base">Entrega y Seguimiento</h4>
            <p class="text-xs text-gray-500 mt-1">
              Envíos rápidos con confirmación inmediata de compra y número de seguimiento.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base">Personalización Total</h4>
            <p class="text-xs text-gray-500 mt-1">
              Elige tallas, colores y extras con cálculo de precio automático en tiempo real.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
