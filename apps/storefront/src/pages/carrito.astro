---
// apps/storefront/src/pages/carrito.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Carrito de Compras"
  description="Revisa tus productos y personalizaciones seleccionadas antes de proceder al pago seguro."
>
  <div class="max-w-7xl mx-auto py-4">
    <!-- Encabezado de la Página -->
    <div class="border-b border-gray-200 pb-5 mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
        Carrito de Compras
      </h1>
      <p class="mt-2 text-sm text-gray-500">
        Revisa los productos, tallas y modificadores agregados a tu compra.
      </p>
    </div>

    <!-- Cuadrícula Principal de 2 Columnas -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Columna Izquierda: Listado dinámico de artículos -->
      <section class="lg:col-span-8">
        <div id="cart-container" class="space-y-4">
          <!-- Renderizado dinámicamente en el cliente vía Nanostores -->
          <div class="flex items-center justify-center p-12 text-gray-400">
            <svg class="animate-spin h-6 w-6 text-gray-400 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span>Cargando artículos...</span>
          </div>
        </div>
      </section>

      <!-- Columna Derecha: Resumen de Compra -->
      <aside class="lg:col-span-4 sticky top-24">
        <div class="rounded-2xl border border-gray-200/90 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-4">
            Resumen de Compra
          </h2>

          <div class="mt-4 space-y-3 text-sm">
            <div class="flex items-center justify-between text-gray-600">
              <span>Subtotal estimado</span>
              <span id="cart-subtotal" class="font-medium text-gray-900">$0.00</span>
            </div>

            <!-- Fila Dinámica de Descuento (Oculta si no hay cupón) -->
            <div id="cart-discount-row" class="hidden items-center justify-between text-emerald-600">
              <span class="flex items-center gap-1.5 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                Descuento <span id="cart-discount-label" class="font-bold"></span>
              </span>
              <span id="cart-discount-amount" class="font-bold">-$0.00</span>
            </div>

            <div class="flex items-center justify-between text-gray-600">
              <span>Envío estándar</span>
              <span class="text-emerald-600 font-medium">Calculado en checkout</span>
            </div>
            <div class="flex items-center justify-between text-gray-600">
              <span>Impuestos estimados</span>
              <span class="text-gray-500 font-medium">Incluidos</span>
            </div>

            <div class="border-t border-gray-100 pt-4 flex items-center justify-between text-base">
              <span class="font-bold text-gray-900">Total a pagar</span>
              <span id="cart-total" class="text-2xl font-black text-gray-900">$0.00</span>
            </div>
          </div>

          <!-- SECCIÓN: CÓDIGO DE DESCUENTO -->
          <div class="mt-5 pt-4 border-t border-gray-100 space-y-2">
            <label for="discount-code-input" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
              ¿Tienes un cupón de descuento?
            </label>

            <div id="discount-input-container" class="flex gap-2">
              <input
                type="text"
                id="discount-code-input"
                placeholder="Ej. ARTE10"
                class="flex-1 rounded-xl border border-gray-200 px-3.5 py-2 text-xs font-mono font-bold uppercase tracking-wider text-black focus:border-black focus:ring-black"
              />
              <button
                type="button"
                id="apply-discount-btn"
                class="px-4 py-2 rounded-xl bg-black hover:bg-gray-800 text-white text-xs font-bold shadow-sm transition-all active:scale-95 disabled:opacity-40"
              >
                Aplicar
              </button>
            </div>

            <!-- Badge de Cupón Activo -->
            <div id="applied-discount-badge" class="hidden items-center justify-between p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs">
              <div class="flex items-center gap-2 text-emerald-800 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                <span id="applied-discount-text"></span>
              </div>
              <button
                type="button"
                id="remove-discount-btn"
                class="text-emerald-600 hover:text-red-600 p-1 font-bold text-xs"
                title="Quitar cupón"
              >
                ✕
              </button>
            </div>

            <p id="discount-message" class="text-[11px] font-medium hidden"></p>
          </div>

          <div class="mt-4 pt-3 border-t border-gray-100 space-y-1.5">
            <label for="customer-email" class="block text-xs font-semibold text-gray-700">
              Correo para recibir confirmación de compra:
            </label>
            <input
              type="email"
              id="customer-email"
              placeholder="tu-correo@ejemplo.com"
              class="w-full rounded-xl border border-gray-200 px-3.5 py-2 text-sm text-gray-900 focus:border-black focus:ring-black"
            />
          </div>

          <div class="mt-5 space-y-3">
            <button
              id="checkout-btn"
              type="button"
              class="w-full flex items-center justify-center gap-2 rounded-xl bg-gray-900 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition-all duration-200 hover:bg-black active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-gray-900"
            >
              <span>Proceder al Pago</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>

            <a
              href="/catalogo"
              class="w-full block text-center py-2.5 text-sm font-medium text-gray-600 hover:text-black transition-colors"
            >
              &larr; Continuar comprando
            </a>
          </div>

          <!-- Sellos de Seguridad / Confianza -->
          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-center gap-4 text-xs text-gray-400">
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v4a1 1 0 102 0V7z" clip-rule="evenodd" />
              </svg>
              Pago seguro vía Mercado Pago
            </span>
          </div>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<script>
  import { $cart, removeItem, updateQuantity } from '../store/cart';

  const currencyFormatter = new Intl.NumberFormat('es-MX', {
    style: 'currency',
    currency: 'MXN',
  });

  const cartContainer = document.getElementById('cart-container');
  const cartTotal = document.getElementById('cart-total');
  const cartSubtotal = document.getElementById('cart-subtotal');
  const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement | null;

  function renderCart(): void {
    if (!cartContainer || !cartTotal || !cartSubtotal) return;

    const cartItems = $cart.get();

    // 1. Estado de Carrito Vacío
    if (cartItems.length === 0) {
      cartContainer.innerHTML = `
        <div class="rounded-2xl border border-dashed border-gray-300 bg-white p-12 text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-gray-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <h3 class="mt-4 text-lg font-bold text-gray-900">Tu carrito está vacío</h3>
          <p class="mt-1 text-sm text-gray-500">Parece que aún no has agregado productos a tu compra.</p>
          <div class="mt-6">
            <a
              href="/catalogo"
              class="inline-flex items-center gap-2 rounded-xl bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-black transition-colors"
            >
              Explorar Catálogo &rarr;
            </a>
          </div>
        </div>
      `;

      cartTotal.textContent = currencyFormatter.format(0);
      cartSubtotal.textContent = currencyFormatter.format(0);
      if (checkoutBtn) checkoutBtn.disabled = true;
      return;
    }

    // 2. Renderizado de Artículos con Modificadores
    let totalCents = 0;
    let itemsHtml = '';

    cartItems.forEach((item) => {
      const itemKey = item.instanceId || item.id;
      const unitCents = item.unitPrice || item.basePrice || 0;
      const itemTotalCents = unitCents * item.quantity;
      totalCents += itemTotalCents;

      const unitFormatted = currencyFormatter.format(unitCents / 100);
      const subtotalFormatted = currencyFormatter.format(itemTotalCents / 100);

      // Renderizar tags de modificadores seleccionados
      let modifiersHtml = '';
      if (item.selectedModifiers && item.selectedModifiers.length > 0) {
        const badges = item.selectedModifiers
          .map((m) => {
            const deltaText = m.priceDelta > 0 
              ? ` (+${currencyFormatter.format(m.priceDelta / 100)})` 
              : '';
            return `<span class="inline-flex items-center gap-1 rounded-md bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-700 border border-gray-200">
              <strong>${m.modifierName}:</strong> ${m.optionName}${deltaText}
            </span>`;
          })
          .join('');
        modifiersHtml = `<div class="mt-2 flex flex-wrap gap-1.5">${badges}</div>`;
      }

      itemsHtml += `
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 rounded-2xl border border-gray-200/90 bg-white p-4 sm:p-5 shadow-sm transition-all hover:border-gray-300">
          <div class="flex items-start gap-4 w-full sm:w-auto flex-1">
            <div class="h-20 w-20 flex-shrink-0 overflow-hidden rounded-xl bg-gray-100 border border-gray-200">
              <img
                src="${item.image || 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=800&auto=format&fit=crop&q=80'}"
                alt="${item.title}"
                class="h-full w-full object-cover object-center"
              />
            </div>

            <div class="flex-1">
              <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider">${item.category || 'General'}</span>
              <h3 class="text-base font-bold text-gray-900">${item.title}</h3>
              <p class="text-xs text-gray-500 mt-0.5">${unitFormatted} c/u</p>
              ${modifiersHtml}
            </div>
          </div>

          <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto border-t sm:border-t-0 pt-3 sm:pt-0 border-gray-100">
            <!-- Selector de Cantidad -->
            <div class="flex items-center border border-gray-200 rounded-xl bg-gray-50 p-0.5">
              <button
                type="button"
                data-qty-decrease="${itemKey}"
                class="px-2 py-1 text-gray-600 hover:text-black hover:bg-white rounded-lg transition-colors text-xs font-bold"
                title="Reducir cantidad"
              >
                -
              </button>
              <span class="px-3 py-1 text-xs font-bold text-gray-900">
                ${item.quantity}
              </span>
              <button
                type="button"
                data-qty-increase="${itemKey}"
                class="px-2 py-1 text-gray-600 hover:text-black hover:bg-white rounded-lg transition-colors text-xs font-bold"
                title="Aumentar cantidad"
              >
                +
              </button>
            </div>

            <div class="text-right min-w-[90px]">
              <span class="text-base font-bold text-gray-900">${subtotalFormatted}</span>
            </div>

            <button
              type="button"
              data-remove-id="${itemKey}"
              class="p-2 text-gray-400 hover:text-red-600 rounded-lg hover:bg-red-50 transition-colors"
              title="Eliminar producto"
              aria-label="Eliminar ${item.title}"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" stroke-width="1.75" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </button>
          </div>
        </div>
      `;
    });

    cartContainer.innerHTML = itemsHtml;

    // 3. Formateo y Actualización de Totales con Descuento
    updateTotals(totalCents);
    if (checkoutBtn) checkoutBtn.disabled = false;

    // 4. Delegación de Eventos para botones
    cartContainer.querySelectorAll<HTMLButtonElement>('button[data-remove-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-remove-id');
        if (id) removeItem(id);
      });
    });

    cartContainer.querySelectorAll<HTMLButtonElement>('button[data-qty-decrease]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-qty-decrease');
        const item = cartItems.find((i) => (i.instanceId || i.id) === id);
        if (item) updateQuantity(id!, item.quantity - 1);
      });
    });

    cartContainer.querySelectorAll<HTMLButtonElement>('button[data-qty-increase]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-qty-increase');
        const item = cartItems.find((i) => (i.instanceId || i.id) === id);
        if (item) updateQuantity(id!, item.quantity + 1);
      });
    });
  }

  // Estado del Cupón en memoria del cliente
  interface ActiveCoupon {
    code: string;
    discountType: string;
    discountValue: number;
    discountAmount: number;
  }
  let activeCoupon: ActiveCoupon | null = null;

  function updateTotals(subtotalCents: number): void {
    if (!cartTotal || !cartSubtotal) return;

    cartSubtotal.textContent = currencyFormatter.format(subtotalCents / 100);

    const discountRow = document.getElementById('cart-discount-row');
    const discountLabel = document.getElementById('cart-discount-label');
    const discountAmountEl = document.getElementById('cart-discount-amount');

    if (activeCoupon && subtotalCents > 0) {
      // Recalcular descuento según subtotal actual
      let calculatedDiscountCents = 0;
      if (activeCoupon.discountType === 'percentage') {
        calculatedDiscountCents = Math.round((subtotalCents * activeCoupon.discountValue) / 100);
      } else {
        calculatedDiscountCents = Math.min(activeCoupon.discountValue, subtotalCents);
      }

      activeCoupon.discountAmount = calculatedDiscountCents;
      const finalTotalCents = Math.max(0, subtotalCents - calculatedDiscountCents);

      if (discountRow) discountRow.classList.remove('hidden');
      if (discountRow) discountRow.classList.add('flex');
      if (discountLabel) discountLabel.textContent = `(${activeCoupon.code})`;
      if (discountAmountEl) {
        discountAmountEl.textContent = `-${currencyFormatter.format(calculatedDiscountCents / 100)}`;
      }

      cartTotal.textContent = currencyFormatter.format(finalTotalCents / 100);
    } else {
      if (discountRow) discountRow.classList.add('hidden');
      if (discountRow) discountRow.classList.remove('flex');
      cartTotal.textContent = currencyFormatter.format(subtotalCents / 100);
    }
  }

  $cart.subscribe(() => {
    renderCart();
  });

  document.addEventListener('astro:page-load', () => {
    renderCart();

    // 1. Manejo de Cupón de Descuento
    const discountInput = document.getElementById('discount-code-input') as HTMLInputElement | null;
    const applyDiscountBtn = document.getElementById('apply-discount-btn') as HTMLButtonElement | null;
    const discountMessage = document.getElementById('discount-message');
    const appliedBadge = document.getElementById('applied-discount-badge');
    const appliedText = document.getElementById('applied-discount-text');
    const removeDiscountBtn = document.getElementById('remove-discount-btn');
    const discountInputContainer = document.getElementById('discount-input-container');

    const showDiscountMsg = (msg: string, isError: boolean) => {
      if (!discountMessage) return;
      discountMessage.textContent = msg;
      discountMessage.className = `text-[11px] font-medium ${isError ? 'text-red-500' : 'text-emerald-600'}`;
      discountMessage.classList.remove('hidden');
    };

    if (applyDiscountBtn && discountInput) {
      applyDiscountBtn.addEventListener('click', async () => {
        const code = discountInput.value.trim().toUpperCase();
        if (!code) {
          showDiscountMsg('Ingresa un código de descuento', true);
          return;
        }

        const cartItems = $cart.get();
        const currentSubtotalCents = cartItems.reduce(
          (sum, i) => sum + (i.unitPrice || i.basePrice || 0) * i.quantity,
          0
        );

        if (currentSubtotalCents <= 0) {
          showDiscountMsg('El carrito está vacío', true);
          return;
        }

        applyDiscountBtn.disabled = true;
        applyDiscountBtn.textContent = '...';

        try {
          const res = await fetch('/api/discount/validate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code, cartSubtotal: currentSubtotalCents }),
          });

          const data = await res.json();

          if (res.ok && data.valid) {
            activeCoupon = {
              code: data.code,
              discountType: data.discountType,
              discountValue: data.discountValue,
              discountAmount: data.discountAmount,
            };

            // Mostrar badge y ocultar input
            if (discountInputContainer) discountInputContainer.classList.add('hidden');
            if (appliedBadge) {
              appliedBadge.classList.remove('hidden');
              appliedBadge.classList.add('flex');
            }
            if (appliedText) {
              appliedText.textContent = `${data.code} (${data.message})`;
            }
            showDiscountMsg('', false);

            renderCart();
          } else {
            showDiscountMsg(data.error || 'Código de descuento no válido', true);
          }
        } catch (e: any) {
          showDiscountMsg('Error al verificar el cupón', true);
        } finally {
          applyDiscountBtn.disabled = false;
          applyDiscountBtn.textContent = 'Aplicar';
        }
      });
    }

    if (removeDiscountBtn) {
      removeDiscountBtn.addEventListener('click', () => {
        activeCoupon = null;
        if (appliedBadge) {
          appliedBadge.classList.add('hidden');
          appliedBadge.classList.remove('flex');
        }
        if (discountInputContainer) discountInputContainer.classList.remove('hidden');
        if (discountInput) discountInput.value = '';
        if (discountMessage) discountMessage.classList.add('hidden');
        renderCart();
      });
    }

    // 2. Checkout Click con Cupón
    const checkoutBtnEl = document.getElementById('checkout-btn') as HTMLButtonElement | null;
    if (checkoutBtnEl) {
      checkoutBtnEl.addEventListener('click', async () => {
        const cartItems = $cart.get();
        if (cartItems.length === 0) return;

        const emailInput = document.getElementById('customer-email') as HTMLInputElement | null;
        const customerEmail = emailInput?.value?.trim() || '';

        const originalText = checkoutBtnEl.innerHTML;
        checkoutBtnEl.disabled = true;
        checkoutBtnEl.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          Procesando tu pedido...
        `;

        try {
          const response = await fetch('/api/checkout', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: cartItems,
              customerEmail,
              discountCode: activeCoupon ? activeCoupon.code : undefined,
            }),
          });

          if (response.ok) {
            const { url } = await response.json();
            $cart.set([]); // Limpiar carrito
            window.location.href = url;
          } else {
            const errData = await response.json().catch(() => null);
            throw new Error(errData?.error || 'Error al generar la sesión de pago');
          }
        } catch (error: any) {
          console.error('Checkout error:', error);
          alert(error.message || 'Hubo un error al procesar tu pago. Por favor intenta de nuevo.');
          checkoutBtnEl.disabled = false;
          checkoutBtnEl.innerHTML = originalText;
        }
      });
    }
  });
</script>
