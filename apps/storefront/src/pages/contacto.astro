---
import Layout from '../layouts/Layout.astro';

// Configuración de la página de contacto (Editable por el negocio)
const contactInfo = {
  title: "Contáctanos",
  subtitle: "Estamos aquí para ayudarte. Envíanos tus dudas o comentarios.",
  email: "soporte@tutienda.com",
  phone: "+52 55 1234 5678",
  address: "Av. Principal 123, Ciudad de México",
  businessHours: "Lunes a Viernes de 9:00 AM a 6:00 PM"
};
---

<Layout title={contactInfo.title} description={contactInfo.subtitle}>
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-extrabold text-gray-900 tracking-tight text-center mb-4">
        {contactInfo.title}
      </h1>
      <p class="text-lg text-gray-500 text-center mb-12">
        {contactInfo.subtitle}
      </p>

      <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-gray-100">
        <div class="grid grid-cols-1 md:grid-cols-2">
          
          <!-- Información de Contacto -->
          <div class="bg-indigo-600 p-10 text-white flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-semibold mb-6">Información de Negocio</h3>
              
              <div class="space-y-6">
                <div class="flex items-start">
                  <svg class="h-6 w-6 text-indigo-200 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <div class="ml-4">
                    <p class="text-sm font-medium text-indigo-200">Email</p>
                    <p class="text-base">{contactInfo.email}</p>
                  </div>
                </div>

                <div class="flex items-start">
                  <svg class="h-6 w-6 text-indigo-200 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <div class="ml-4">
                    <p class="text-sm font-medium text-indigo-200">Teléfono</p>
                    <p class="text-base">{contactInfo.phone}</p>
                  </div>
                </div>

                <div class="flex items-start">
                  <svg class="h-6 w-6 text-indigo-200 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <div class="ml-4">
                    <p class="text-sm font-medium text-indigo-200">Ubicación</p>
                    <p class="text-base">{contactInfo.address}</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="mt-10">
              <p class="text-sm text-indigo-200 font-medium">Horario de Atención</p>
              <p class="text-base">{contactInfo.businessHours}</p>
            </div>
          </div>

          <!-- Formulario (Visual) -->
          <div class="p-10">
            <h3 class="text-xl font-semibold text-gray-900 mb-6">Envíanos un mensaje</h3>
            <form class="space-y-6" onsubmit="return false;">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Nombre completo</label>
                <input type="text" id="name" name="name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 border" required>
              </div>
              
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Correo electrónico</label>
                <input type="email" id="email" name="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 border" required>
              </div>
              
              <div>
                <label for="message" class="block text-sm font-medium text-gray-700">Mensaje</label>
                <textarea id="message" name="message" rows="4" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 border" required></textarea>
              </div>
              
              <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors">
                Enviar Mensaje
              </button>
            </form>
          </div>
          
        </div>
      </div>
    </div>
  </div>
</Layout>
