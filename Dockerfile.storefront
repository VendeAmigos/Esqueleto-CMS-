# Dockerfile.storefront — Producción Optimizada (Astro Standalone)
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# 1. Fase de Dependencias y Build
FROM base AS builder
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @esqueleto/storefront build

# 2. Fase de Producción
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV DOCKER_CONTAINER=1
ENV HOST=0.0.0.0
ENV PORT=4321
ENV UPLOADS_DIR="/app/uploads"

RUN mkdir -p /app/uploads/.cms-data

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/storefront/node_modules ./apps/storefront/node_modules
COPY --from=builder /app/apps/storefront/dist ./apps/storefront/dist
COPY --from=builder /app/apps/storefront/package.json ./apps/storefront/package.json
COPY --from=builder ["/app/Logo Afótica.svg", "./Logo Afótica.svg"]

EXPOSE 4321

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4321/api/health || exit 1

CMD ["node", "./apps/storefront/dist/server/entry.mjs"]
