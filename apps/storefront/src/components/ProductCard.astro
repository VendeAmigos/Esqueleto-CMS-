---
// apps/storefront/src/components/ProductCard.astro

interface ModifierOptionData {
  id: string;
  name: string;
  priceDelta: number; // Centavos
  isDefault: boolean;
}

interface ModifierGroupData {
  id: string;
  name: string;
  type: 'single' | 'multiple';
  required: boolean;
  options: ModifierOptionData[];
}

interface Props {
  id: string;
  name: string;
  price: number; // Siempre en centavos (ej. 29900 = $299.00)
  image: string;
  category: string;
  description?: string;
  modifiers?: ModifierGroupData[];
}

const { id, name, price, image, category, description, modifiers = [] } = Astro.props;

const formattedPrice = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
}).format(price / 100);

const hasModifiers = modifiers && modifiers.length > 0;
const cardId = `product-card-${id}`;
---

<article
  id={cardId}
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200/90 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
  data-product-json={JSON.stringify({ id, name, price, image, category, modifiers })}
>
  <!-- Contenedor de la Imagen con Badges y Enlace a Detalle -->
  <a
    href={`/producto/${id}`}
    class="relative aspect-square w-full overflow-hidden bg-gray-100 block cursor-pointer group/img"
  >
    <img
      src={image}
      alt={name}
      loading="lazy"
      class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
    />
    <span class="absolute top-3 left-3 rounded-full bg-white/95 backdrop-blur-sm px-3 py-1 text-xs font-semibold text-gray-800 shadow-sm border border-gray-100">
      {category}
    </span>
    {hasModifiers && (
      <span class="absolute bottom-3 left-3 rounded-full bg-indigo-900/90 text-white backdrop-blur-sm px-2.5 py-0.5 text-[11px] font-medium shadow-sm flex items-center gap-1">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
        Personalizable
      </span>
    )}
  </a>

  <!-- Detalles del Producto -->
  <div class="flex flex-1 flex-col p-5">
    <a href={`/producto/${id}`} class="group/title block">
      <h3 class="text-base font-bold text-gray-900 group-hover/title:text-indigo-600 transition-colors line-clamp-1">
        {name}
      </h3>
    </a>

    {description && (
      <p class="mt-1 text-xs text-gray-500 line-clamp-2 leading-relaxed">
        {description}
      </p>
    )}
    
    <div class="mt-3 flex items-baseline justify-between">
      <div>
        <span class="text-xs text-gray-400 block font-medium">
          {hasModifiers ? 'Desde' : 'Precio'}
        </span>
        <span class="text-lg font-black text-gray-900">
          {formattedPrice}
        </span>
      </div>
      <span class="text-[11px] text-gray-400">
        MXN con IVA
      </span>
    </div>

    <!-- Botón de Acción -->
    <div class="mt-5 pt-3 border-t border-gray-100">
      {hasModifiers ? (
        <a
          href={`/producto/${id}`}
          class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-200 hover:bg-black active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
          </svg>
          <span>Personalizar</span>
        </a>
      ) : (
        <button
          type="button"
          data-action-btn
          class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gray-900 px-4 py-2.5 text-sm font-semibold text-white transition-all duration-200 hover:bg-black active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-gray-900 focus:ring-offset-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span>Agregar al carrito</span>
        </button>
      )}
    </div>
  </div>

  <!-- Modal de Modificadores (si tiene opciones configurables) -->
  {hasModifiers && (
    <dialog
      data-modal
      class="product-modal backdrop:bg-black/60 rounded-3xl p-0 shadow-2xl border border-gray-200 w-full max-w-lg overflow-hidden m-auto"
    >
      <div class="p-6 bg-white max-h-[85vh] overflow-y-auto space-y-6">
        <!-- Cabecera del Modal -->
        <div class="flex items-start justify-between border-b border-gray-100 pb-4">
          <div class="flex items-center gap-3">
            <img
              src={image}
              alt={name}
              class="h-14 w-14 rounded-xl object-cover border border-gray-200"
            />
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600">{category}</span>
              <h4 class="text-lg font-bold text-gray-900">{name}</h4>
              <p class="text-xs text-gray-400">Base: {formattedPrice}</p>
            </div>
          </div>
          <button
            type="button"
            data-close-modal
            class="text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Lista de Modificadores Dinámicos -->
        <div class="space-y-5">
          {modifiers.map((group) => (
            <div class="rounded-2xl border border-gray-200 bg-gray-50/60 p-4 space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-gray-900">
                  {group.name}
                  {group.required && <span class="text-red-500 ml-1">*</span>}
                </span>
                <span class="text-[11px] font-medium text-gray-500">
                  {group.type === 'single' ? 'Elige 1' : 'Opcional'}
                </span>
              </div>

              <div class="space-y-2">
                {group.options.map((opt) => {
                  const deltaFormatted = opt.priceDelta > 0 
                    ? `+${new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(opt.priceDelta / 100)}`
                    : 'Sin costo extra';

                  return (
                    <label class="flex items-center justify-between p-2.5 rounded-xl border border-gray-200 bg-white hover:border-black cursor-pointer transition-all">
                      <div class="flex items-center gap-2.5">
                        <input
                          type={group.type === 'single' ? 'radio' : 'checkbox'}
                          name={`mod-${id}-${group.id}`}
                          value={opt.id}
                          data-group-id={group.id}
                          data-group-name={group.name}
                          data-opt-id={opt.id}
                          data-opt-name={opt.name}
                          data-delta={opt.priceDelta}
                          checked={opt.isDefault}
                          class="h-4 w-4 text-black focus:ring-black border-gray-300"
                        />
                        <span class="text-xs font-semibold text-gray-800">{opt.name}</span>
                      </div>
                      <span class={`text-xs font-mono font-medium ${opt.priceDelta > 0 ? 'text-gray-900 font-bold' : 'text-gray-400'}`}>
                        {deltaFormatted}
                      </span>
                    </label>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <!-- Pie del Modal con Precio Dinámico Calculado -->
        <div class="border-t border-gray-100 pt-4 flex items-center justify-between gap-4">
          <div>
            <span class="text-[11px] font-medium text-gray-400 block">Total con opciones</span>
            <span data-modal-total class="text-2xl font-black text-gray-900">
              {formattedPrice}
            </span>
          </div>
          <button
            type="button"
            data-confirm-add
            class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-black px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-gray-800 transition-all active:scale-[0.98]"
          >
            <span>Agregar al Carrito</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </div>
    </dialog>
  )}
</article>

<script>
  import { addItem } from '../store/cart';

  const currencyFormatter = new Intl.NumberFormat('es-MX', {
    style: 'currency',
    currency: 'MXN',
  });

  function initCards() {
    const cards = document.querySelectorAll<HTMLElement>('article[data-product-json]');

    cards.forEach((card) => {
      if (card.dataset.initialized === 'true') return;
      card.dataset.initialized = 'true';

      const raw = card.getAttribute('data-product-json');
      if (!raw) return;
      const product = JSON.parse(raw);

      const actionBtn = card.querySelector<HTMLButtonElement>('button[data-action-btn]');
      const modal = card.querySelector<HTMLDialogElement>('dialog[data-modal]');

      if (!product.modifiers || product.modifiers.length === 0) {
        actionBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          addItem({
            id: product.id,
            title: product.name,
            image: product.image,
            category: product.category,
            basePrice: product.price,
            quantity: 1,
            selectedModifiers: [],
          });

          const textSpan = actionBtn.querySelector('span');
          if (textSpan) {
            const originalText = textSpan.textContent;
            textSpan.textContent = '¡Agregado!';
            actionBtn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
            actionBtn.classList.remove('bg-gray-900', 'hover:bg-black');
            setTimeout(() => {
              textSpan.textContent = originalText;
              actionBtn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
              actionBtn.classList.add('bg-gray-900', 'hover:bg-black');
            }, 1000);
          }
        });
      } else if (modal) {
        const closeBtn = modal.querySelector('button[data-close-modal]');
        const confirmBtn = modal.querySelector<HTMLButtonElement>('button[data-confirm-add]');
        const totalSpan = modal.querySelector<HTMLElement>('[data-modal-total]');

        actionBtn?.addEventListener('click', () => {
          modal.showModal();
          recalculateModalTotal();
        });

        closeBtn?.addEventListener('click', () => {
          modal.close();
        });

        modal.addEventListener('click', (e) => {
          const rect = modal.getBoundingClientRect();
          const isInDialog = (
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width
          );
          if (!isInDialog) {
            modal.close();
          }
        });

        function getSelectedModifiers() {
          const inputs = modal.querySelectorAll<HTMLInputElement>('input[data-opt-id]:checked');
          const selected: any[] = [];
          inputs.forEach((input) => {
            selected.push({
              modifierId: input.dataset.groupId,
              modifierName: input.dataset.groupName,
              optionId: input.dataset.optId,
              optionName: input.dataset.optName,
              priceDelta: parseInt(input.dataset.delta || '0', 10),
            });
          });
          return selected;
        }

        function recalculateModalTotal() {
          const selected = getSelectedModifiers();
          const extraCents = selected.reduce((sum, s) => sum + s.priceDelta, 0);
          const totalCents = product.price + extraCents;
          if (totalSpan) {
            totalSpan.textContent = currencyFormatter.format(totalCents / 100);
          }
        }

        modal.querySelectorAll('input[data-opt-id]').forEach((input) => {
          input.addEventListener('change', recalculateModalTotal);
        });

        confirmBtn?.addEventListener('click', () => {
          const selectedModifiers = getSelectedModifiers();

          addItem({
            id: product.id,
            title: product.name,
            image: product.image,
            category: product.category,
            basePrice: product.price,
            quantity: 1,
            selectedModifiers,
          });

          const span = confirmBtn.querySelector('span');
          if (span) {
            const original = span.textContent;
            span.textContent = '¡Añadido!';
            confirmBtn.classList.add('bg-emerald-600');
            confirmBtn.classList.remove('bg-black');
            setTimeout(() => {
              span.textContent = original;
              confirmBtn.classList.remove('bg-emerald-600');
              confirmBtn.classList.add('bg-black');
              modal.close();
            }, 600);
          }
        });
      }
    });
  }

  initCards();
  document.addEventListener('astro:page-load', initCards);
</script>
