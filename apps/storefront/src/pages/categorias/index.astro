---
// apps/storefront/src/pages/categorias/index.astro
import Layout from '../../layouts/Layout.astro';
import { db, categories, products, eq, ensureSchema, isDatabaseAvailable } from '@esqueleto/core';

const defaultCategories = [
  {
    id: 'cat-prints-01',
    name: 'Prints & Láminas de Arte',
    slug: 'prints-arte',
    imageUrl: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=900&auto=format&fit=crop&q=80',
    gridSpan: '2x2',
    displayOrder: 1,
    productCount: 4,
  },
  {
    id: 'cat-stickers-02',
    name: 'Stickers & Papelería',
    slug: 'stickers-papeleria',
    imageUrl: 'https://images.unsplash.com/photo-1589998059171-988d887df646?w=900&auto=format&fit=crop&q=80',
    gridSpan: '2x1',
    displayOrder: 2,
    productCount: 6,
  },
  {
    id: 'cat-acc-03',
    name: 'Pines & Llaveros Acrílicos',
    slug: 'pines-llaveros',
    imageUrl: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=900&auto=format&fit=crop&q=80',
    gridSpan: '1x2',
    displayOrder: 3,
    productCount: 3,
  },
  {
    id: 'cat-textil-04',
    name: 'Merch Textil & Totebags',
    slug: 'merch-textil',
    imageUrl: 'https://images.unsplash.com/photo-1544816155-12df9643f363?w=900&auto=format&fit=crop&q=80',
    gridSpan: '2x1',
    displayOrder: 4,
    productCount: 2,
  },
  {
    id: 'cat-orig-05',
    name: 'Obras Originales & Libretas',
    slug: 'obras-originales',
    imageUrl: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=900&auto=format&fit=crop&q=80',
    gridSpan: '1x1',
    displayOrder: 5,
    productCount: 1,
  },
];

let categoriesWithCount = [...defaultCategories];
const isDbOnline = await isDatabaseAvailable();

if (isDbOnline) {
  try {
    await ensureSchema();
    const dbCats = await db.select().from(categories).orderBy(categories.displayOrder).execute();
    if (dbCats && dbCats.length > 0) {
      const allActiveProducts = await db
        .select({ id: products.id, categoryId: products.categoryId })
        .from(products)
        .where(eq(products.isActive, true))
        .execute();

      categoriesWithCount = dbCats.map((cat) => ({
        ...cat,
        productCount: allActiveProducts.filter((p) => p.categoryId === cat.id).length,
      }));
    }
  } catch (err) {
    console.warn('Aviso cargando categorías en vivo:', err);
  }
}

// Helper de clases para cualquier tamaño de Bento Grid
import { getGridSpanClasses } from '@esqueleto/core';
const getGridSpanClass = (span: string) => getGridSpanClasses(span);
---

<Layout
  title="Categorías"
  description="Explora todas las colecciones y departamentos de nuestra tienda."
>
  <div class="space-y-10">
    <!-- Encabezado de la página -->
    <div class="border-b border-gray-200 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-xs text-gray-500 mb-2">
          <a href="/" class="hover:text-black transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-black font-semibold">Categorías</span>
        </nav>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900">
          Todas las Categorías
        </h1>
        <p class="mt-2 text-sm text-gray-500">
          Encuentra productos organizados por departamento con opciones y modificadores personalizados.
        </p>
      </div>

      <a
        href="/catalogo"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-semibold transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        Ver Catálogo Completo
      </a>
    </div>

    <!-- Bento Grid de Categorías -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[260px]">
      {categoriesWithCount.map((cat) => (
        <a
          href={`/categorias/${cat.slug}`}
          class={`group relative rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col justify-end p-6 border border-gray-200 ${getGridSpanClass(
            cat.gridSpan
          )}`}
        >
          {cat.imageUrl ? (
            <img
              src={cat.imageUrl}
              alt={cat.name}
              class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
            />
          ) : (
            <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-950" />
          )}

          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent transition-opacity group-hover:via-black/55" />

          <!-- Badge Superior -->
          <div class="relative z-10 self-start mb-auto">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-black/60 text-white/90 backdrop-blur-md border border-white/20 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
              {cat.productCount} {cat.productCount === 1 ? 'producto' : 'productos'}
            </span>
          </div>

          <!-- Contenido Inferior -->
          <div class="relative z-10 space-y-1">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight drop-shadow-md">
              {cat.name}
            </h2>
            <p class="text-xs text-white/80 font-medium inline-flex items-center gap-1 transition-transform group-hover:translate-x-1">
              Ver colección completa &rarr;
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
