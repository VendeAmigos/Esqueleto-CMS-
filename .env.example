# ==============================================================================
# 1. Identificador de Instancia (Producción Lunna de Coco)
# ==============================================================================
APP_SLUG=lunnadecoco
STOREFRONT_PORT=4321
ADMIN_PORT=3001
POSTGRES_HOST_PORT=5434

# ==============================================================================
# 2. Base de Datos PostgreSQL
# ==============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
POSTGRES_DB=lunnadecoco
DATABASE_URL=postgres://admin:CAMBIA_ESTA_CONTRASENA_SEGURA@127.0.0.1:5432/lunnadecoco

# ==============================================================================
# 3. Dominios y URLs Públicas (lunnadecoco.com)
# ==============================================================================
PUBLIC_STOREFRONT_URL=https://lunnadecoco.com
PUBLIC_ADMIN_URL=https://admin.lunnadecoco.com
STOREFRONT_DOMAIN=lunnadecoco.com
WWW_STOREFRONT_DOMAIN=www.lunnadecoco.com
ADMIN_DOMAIN=admin.lunnadecoco.com
CADDY_EMAIL=admin@lunnadecoco.com

# ==============================================================================
# 4. Seguridad del Panel de Administración (CMS)
# ==============================================================================
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIA_CONTRASENA_ADMIN
ADMIN_SECRET=genera-una-llave-aleatoria-de-64-caracteres-aqui

# ==============================================================================
# 5. Pasarela de Pagos Mercado Pago (Opcional en .env: también configurable desde /pagos en el CMS)
# ==============================================================================
PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
