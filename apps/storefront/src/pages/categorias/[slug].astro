---
// apps/storefront/src/pages/categorias/[slug].astro
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  db,
  categories,
  products,
  productModifiers,
  modifierOptions,
  eq,
  and,
  ensureSchema,
  isDatabaseAvailable,
} from '@esqueleto/core';

const fallbackCategories = [
  {
    id: 'cat-prints-01',
    name: 'Prints & Láminas de Arte',
    slug: 'prints-arte',
    imageUrl: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=900&auto=format&fit=crop&q=80',
  },
  {
    id: 'cat-stickers-02',
    name: 'Stickers & Papelería',
    slug: 'stickers-papeleria',
    imageUrl: 'https://images.unsplash.com/photo-1589998059171-988d887df646?w=900&auto=format&fit=crop&q=80',
  },
  {
    id: 'cat-acc-03',
    name: 'Pines & Llaveros Acrílicos',
    slug: 'pines-llaveros',
    imageUrl: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=900&auto=format&fit=crop&q=80',
  },
  {
    id: 'cat-textil-04',
    name: 'Merch Textil & Totebags',
    slug: 'merch-textil',
    imageUrl: 'https://images.unsplash.com/photo-1544816155-12df9643f363?w=900&auto=format&fit=crop&q=80',
  },
  {
    id: 'cat-orig-05',
    name: 'Obras Originales & Libretas',
    slug: 'obras-originales',
    imageUrl: 'https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=900&auto=format&fit=crop&q=80',
  },
];

const fallbackProductsMap: Record<string, any[]> = {
  'prints-arte': [
    {
      id: 'prod-print-jardin',
      title: 'Print Fine Art "El Jardín de los Recuerdos"',
      description: 'Lámina de ilustración impresa en papel algodón de 310g con tintas pigmentadas de archivo.',
      imageUrl: 'https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?w=800&auto=format&fit=crop&q=80',
      basePrice: 18000,
      categoryName: 'Prints & Láminas de Arte',
      modifiers: [
        {
          id: 'mod-size-01',
          name: 'Tamaño de Lámina',
          type: 'single',
          required: true,
          options: [
            { id: 'opt-a5', name: 'A5 (14.8 x 21 cm)', priceDelta: 0, isDefault: true },
            { id: 'opt-a4', name: 'A4 (21 x 29.7 cm)', priceDelta: 6000, isDefault: false },
          ],
        },
      ],
    },
  ],
  'stickers-papeleria': [
    {
      id: 'prod-pack-stickers-brujitas',
      title: 'Pack de Stickers Holográficos "Pequeñas Brujas"',
      description: 'Set de 5 stickers resistentes al agua con acabado holográfico brillante arcoíris.',
      imageUrl: 'https://images.unsplash.com/photo-1589998059171-988d887df646?w=800&auto=format&fit=crop&q=80',
      basePrice: 12000,
      categoryName: 'Stickers & Papelería',
      modifiers: [],
    },
  ],
};

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/categorias');
}

const isDbOnline = await isDatabaseAvailable();
let category: any = null;

if (isDbOnline) {
  try {
    await ensureSchema();
    const [cat] = await db
      .select()
      .from(categories)
      .where(eq(categories.slug, slug))
      .limit(1);
    category = cat;
  } catch (e) {
    console.error('Error buscando categoría:', e);
  }
}

if (!category) {
  category = fallbackCategories.find((c) => c.slug === slug);
}

if (!category) {
  return Astro.redirect('/categorias');
}

// 2. Obtener productos de esta categoría
let dbProducts: any[] = [];
let allModifiers: any[] = [];
let allOptions: any[] = [];

if (isDbOnline) {
  try {
    dbProducts = await db
      .select({
        id: products.id,
        title: products.title,
        description: products.description,
        imageUrl: products.imageUrl,
        basePrice: products.basePrice,
        isFeatured: products.isFeatured,
        categoryName: categories.name,
      })
      .from(products)
      .leftJoin(categories, eq(products.categoryId, categories.id))
      .where(and(eq(products.isActive, true), eq(products.categoryId, category.id)))
      .execute();

    allModifiers = await db.select().from(productModifiers).execute();
    allOptions = await db.select().from(modifierOptions).execute();
  } catch (err) {
    console.error('Error cargando productos por categoría:', err);
  }
}

if (dbProducts.length === 0 && fallbackProductsMap[slug]) {
  dbProducts = fallbackProductsMap[slug];
}

const fullProducts = dbProducts.map((prod) => {
  if (prod.modifiers) return prod;
  const prodMods = allModifiers
    .filter((m) => m.productId === prod.id)
    .map((mod) => {
      const opts = allOptions
        .filter((o) => o.modifierId === mod.id)
        .map((o) => ({
          id: o.id,
          name: o.name,
          priceDelta: o.priceDelta,
          isDefault: o.isDefault,
        }));
      return {
        id: mod.id,
        name: mod.name,
        type: mod.type as 'single' | 'multiple',
        required: mod.required,
        options: opts,
      };
    });

  return {
    ...prod,
    modifiers: prodMods,
  };
});
---

<Layout
  title={category.name}
  description={`Explora los productos de la categoría ${category.name}.`}
>
  <div class="space-y-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-gray-500">
      <a href="/" class="hover:text-black transition-colors">Inicio</a>
      <span>/</span>
      <a href="/categorias" class="hover:text-black transition-colors">Categorías</a>
      <span>/</span>
      <span class="text-black font-semibold">{category.name}</span>
    </nav>

    <!-- Header Banner de la Categoría -->
    <div class="relative overflow-hidden rounded-3xl bg-gray-900 py-12 px-8 sm:px-12 text-white shadow-lg">
      {category.imageUrl && (
        <img
          src={category.imageUrl}
          alt={category.name}
          class="absolute inset-0 h-full w-full object-cover object-center brightness-50"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent" />

      <div class="relative z-10 max-w-2xl space-y-2">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-white/20 backdrop-blur-md text-white border border-white/20">
          Colección
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight drop-shadow-md">
          {category.name}
        </h1>
        <p class="text-sm text-gray-200 drop-shadow">
          {fullProducts.length} {fullProducts.length === 1 ? 'producto disponible' : 'productos disponibles'} en esta categoría.
        </p>
      </div>
    </div>

    <!-- Lista de Productos -->
    {fullProducts.length === 0 ? (
      <div class="text-center py-16 px-4 bg-white rounded-3xl border border-dashed border-gray-300 space-y-4">
        <div class="w-12 h-12 mx-auto rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900">Aún no hay productos en esta categoría</h3>
        <p class="text-sm text-gray-500 max-w-md mx-auto">
          Estamos preparando nuevos artículos para esta sección. Mientras tanto, puedes explorar las demás categorías.
        </p>
        <div class="pt-2">
          <a
            href="/categorias"
            class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-black text-white text-xs font-bold hover:bg-gray-800 transition-colors"
          >
            &larr; Ver otras categorías
          </a>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {fullProducts.map((product) => (
          <ProductCard
            id={product.id}
            name={product.title}
            price={product.basePrice}
            image={product.imageUrl || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop&q=80'}
            category={product.categoryName || category.name}
            description={product.description || ''}
            modifiers={product.modifiers}
          />
        ))}
      </div>
    )}
  </div>
</Layout>
