---
// apps/storefront/src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import {
  db,
  products,
  categories,
  productModifiers,
  modifierOptions,
  siteSettings,
  eq,
} from '@esqueleto/core';

// 1. Obtener configuración del sitio / Apariencia
let settings = {
  siteName: 'ESQUELETO',
  logoColor: '#4f46e5',
  heroTitle: 'Velocidad extrema. Control total en Docker.',
  heroSubtitle: 'E-commerce Open Source Plug & Play de alto rendimiento con catálogo interactivo y checkout seguro.',
  heroImageUrl: 'https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1600&q=80',
  heroCtaText: 'Explorar Catálogo',
  heroCtaLink: '/catalogo',
};

try {
  const settingsList = await db.select().from(siteSettings).where(eq(siteSettings.id, 'default')).execute();
  if (settingsList[0]) {
    settings = {
      siteName: settingsList[0].siteName || settings.siteName,
      logoColor: settingsList[0].logoColor || settings.logoColor,
      heroTitle: settingsList[0].heroTitle || settings.heroTitle,
      heroSubtitle: settingsList[0].heroSubtitle || settings.heroSubtitle,
      heroImageUrl: settingsList[0].heroImageUrl || settings.heroImageUrl,
      heroCtaText: settingsList[0].heroCtaText || settings.heroCtaText,
      heroCtaLink: settingsList[0].heroCtaLink || settings.heroCtaLink,
    };
  }
} catch (e) {
  // Manejo seguro si la base de datos se está aprovisionando
}

// 2. Obtener Categorías ordenadas para el Bento Grid
const allCategories = await db
  .select()
  .from(categories)
  .orderBy(categories.displayOrder)
  .execute();

// Contar productos activos por categoría
const allActiveProducts = await db
  .select({ id: products.id, categoryId: products.categoryId })
  .from(products)
  .where(eq(products.isActive, true))
  .execute();

const categoriesWithCount = allCategories.map((cat) => {
  const count = allActiveProducts.filter((p) => p.categoryId === cat.id).length;
  return {
    ...cat,
    productCount: count,
  };
});

// 3. Obtener Productos Destacados
let featuredRaw = await db
  .select({
    id: products.id,
    title: products.title,
    description: products.description,
    imageUrl: products.imageUrl,
    basePrice: products.basePrice,
    isFeatured: products.isFeatured,
    categoryName: categories.name,
  })
  .from(products)
  .leftJoin(categories, eq(products.categoryId, categories.id))
  .where(eq(products.isActive, true))
  .execute();

// Filtrar destacados o usar los primeros 4 si no hay ninguno marcado aún
let featuredProductsList = featuredRaw.filter((p) => p.isFeatured);
if (featuredProductsList.length === 0) {
  featuredProductsList = featuredRaw.slice(0, 4);
}

// Asociar modificadores a los productos destacados
const allModifiers = await db.select().from(productModifiers).execute();
const allOptions = await db.select().from(modifierOptions).execute();

const featuredProducts = featuredProductsList.map((prod) => {
  const prodMods = allModifiers
    .filter((m) => m.productId === prod.id)
    .map((mod) => {
      const opts = allOptions
        .filter((o) => o.modifierId === mod.id)
        .map((o) => ({
          id: o.id,
          name: o.name,
          priceDelta: o.priceDelta,
          isDefault: o.isDefault,
        }));
      return {
        id: mod.id,
        name: mod.name,
        type: mod.type as 'single' | 'multiple',
        required: mod.required,
        options: opts,
      };
    });

  return {
    ...prod,
    modifiers: prodMods,
  };
});

// Helper de clases para el Bento Grid
const getGridSpanClass = (span: string) => {
  switch (span) {
    case 'col-2':
      return 'col-span-1 md:col-span-2 row-span-1 min-h-[240px]';
    case 'tall':
      return 'col-span-1 row-span-2 min-h-[500px]';
    case 'large':
      return 'col-span-1 md:col-span-2 row-span-2 min-h-[500px]';
    case 'col-1':
    default:
      return 'col-span-1 row-span-1 min-h-[240px]';
  }
};
---

<Layout title="Inicio" description={settings.heroSubtitle}>
  <div class="space-y-16">
    
    <!-- 1. BANNER HERO PRINCIPAL (EDITABLE DESDE EL CMS) -->
    <section class="relative isolate overflow-hidden rounded-3xl bg-gray-950 py-20 sm:py-32 shadow-2xl text-center">
      {settings.heroImageUrl && (
        <img
          src={settings.heroImageUrl}
          alt={settings.heroTitle}
          class="absolute inset-0 -z-10 h-full w-full object-cover object-center brightness-75 scale-100 transition-transform duration-1000"
        />
      )}
      <!-- Gradiente oscuro y viñeta para legibilidad óptima -->
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-gray-950 via-gray-950/60 to-gray-950/30 backdrop-blur-[1px]" />

      <div class="mx-auto max-w-3xl px-6 lg:px-8">
        <span
          class="inline-flex items-center gap-1.5 rounded-full px-3.5 py-1 text-xs font-semibold ring-1 ring-inset mb-6 backdrop-blur-md"
          style={`background-color: ${settings.logoColor}25; color: ${settings.logoColor}; border-color: ${settings.logoColor}55;`}
        >
          <span class="w-1.5 h-1.5 rounded-full animate-pulse" style={`background-color: ${settings.logoColor};`} />
          {settings.siteName} • Catálogo Oficial
        </span>

        <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl drop-shadow-md">
          {settings.heroTitle}
        </h1>

        <p class="mt-6 text-lg sm:text-xl leading-8 text-gray-200 drop-shadow max-w-2xl mx-auto font-light">
          {settings.heroSubtitle}
        </p>

        <div class="mt-10 flex items-center justify-center gap-x-4">
          <a
            href={settings.heroCtaLink}
            class="rounded-xl px-8 py-4 text-base font-bold text-white shadow-xl transition-all duration-200 hover:scale-105 active:scale-95"
            style={`background-color: ${settings.logoColor};`}
          >
            {settings.heroCtaText} &rarr;
          </a>
          <a
            href="/categorias"
            class="rounded-xl px-6 py-4 text-base font-semibold text-white/90 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 transition-all hover:scale-105"
          >
            Ver Categorías
          </a>
        </div>
      </div>
    </section>

    <!-- 2. BENTO GRID DE CATEGORÍAS (LAYOUT DINÁMICO EDITABLE DESDE EL CMS) -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-gray-200 pb-4 gap-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-md">
            Colecciones
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 mt-1">
            Explora por Categorías
          </h2>
          <p class="text-sm text-gray-500">
            Descubre nuestra variedad de productos clasificados para ti.
          </p>
        </div>
        <a
          href="/categorias"
          class="text-sm font-bold text-gray-900 hover:text-indigo-600 transition-colors inline-flex items-center gap-1 group"
        >
          Ver todas las categorías <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>

      <!-- Bento Grid Container -->
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-5 auto-rows-[240px]">
        {categoriesWithCount.map((cat) => (
          <a
            href={`/categorias/${cat.slug}`}
            class={`group relative rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 flex flex-col justify-end p-6 border border-gray-200/80 ${getGridSpanClass(
              cat.gridSpan
            )}`}
          >
            <!-- Imagen con efecto hover zoom -->
            {cat.imageUrl ? (
              <img
                src={cat.imageUrl}
                alt={cat.name}
                class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
              />
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-950" />
            )}

            <!-- Gradiente oscuro para texto -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent transition-opacity group-hover:via-black/50" />

            <!-- Badge Superior: Contador de Productos -->
            <div class="relative z-10 self-start mb-auto">
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-black/60 text-white/90 backdrop-blur-md border border-white/20">
                <span>📦</span>
                {cat.productCount} {cat.productCount === 1 ? 'producto' : 'productos'}
              </span>
            </div>

            <!-- Título y Enlace -->
            <div class="relative z-10 space-y-1">
              <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight drop-shadow-md">
                {cat.name}
              </h3>
              <p class="text-xs text-white/80 font-medium inline-flex items-center gap-1 transition-transform group-hover:translate-x-1">
                Explorar productos &rarr;
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 3. SECCIÓN DE PRODUCTOS DESTACADOS (CMS MANAGED) -->
    <section class="space-y-6 pt-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-gray-200 pb-4 gap-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full inline-flex items-center gap-1">
            <span>⭐</span> Lo más destacado
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 mt-1">
            Productos Destacados
          </h2>
          <p class="text-sm text-gray-500">
            Nuestros artículos más populares con opciones personalizables y entrega rápida.
          </p>
        </div>
        <a
          href="/catalogo"
          class="text-sm font-bold text-gray-900 hover:text-indigo-600 transition-colors inline-flex items-center gap-1 group"
        >
          Ver catálogo completo <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>

      <!-- Grid de Productos Destacados -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard
            id={product.id}
            name={product.title}
            price={product.basePrice}
            image={product.imageUrl || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop&q=80'}
            category={product.categoryName || 'Destacado'}
            description={product.description || ''}
            modifiers={product.modifiers}
          />
        ))}
      </div>
    </section>

    <!-- 4. BENEFICIOS Y CONFIANZA -->
    <section class="border-t border-gray-200/80 pt-12 pb-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center sm:text-left">
        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl shrink-0">
            🛡️
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base">Pagos 100% Protegidos</h4>
            <p class="text-xs text-gray-500 mt-1">
              Checkout Pro con Mercado Pago, tarjetas de crédito/débito y transferencias seguras.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl shrink-0">
            🚀
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base">Entrega y Seguimiento</h4>
            <p class="text-xs text-gray-500 mt-1">
              Envíos rápidos con confirmación inmediata de compra y número de seguimiento.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4 p-4 rounded-2xl bg-white border border-gray-100 shadow-sm">
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl shrink-0">
            🎨
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base">Personalización Total</h4>
            <p class="text-xs text-gray-500 mt-1">
              Elige tallas, colores y extras con cálculo de precio automático en tiempo real.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>
