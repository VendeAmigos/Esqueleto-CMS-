---
// apps/storefront/src/pages/orden-confirmada.astro
import Layout from '../layouts/Layout.astro';
import { db, orders, eq, ensureSchema } from '@esqueleto/core';

try {
  await ensureSchema();
} catch (e) {}

const orderId = Astro.url.searchParams.get('order_id');
const statusParam = Astro.url.searchParams.get('status') || Astro.url.searchParams.get('collection_status');
const paymentId = Astro.url.searchParams.get('payment_id');
const isDemoMode = Astro.url.searchParams.get('mode') === 'demo';

let orderData: any = null;
if (orderId) {
  try {
    const results = await db.select().from(orders).where(eq(orders.id, orderId));
    if (results.length > 0) {
      orderData = results[0];
    }
  } catch (err) {
    console.error('Error consultando orden:', err);
  }
}

const isApproved = statusParam === 'approved' || orderData?.status === 'paid';
const isPending = statusParam === 'pending' || orderData?.status === 'pending';

const currencyFormatter = new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
});
---

<Layout
  title={isApproved ? "¡Orden Confirmada!" : "Estado del Pedido"}
  description="Resumen y confirmación de tu compra en nuestra tienda."
>
  <div class="max-w-2xl mx-auto py-12 px-4 sm:px-6">
    <div class="bg-white border border-gray-200 rounded-3xl p-8 sm:p-12 shadow-sm text-center">
      {isApproved ? (
        <>
          {isDemoMode && (
            <div class="mb-6 p-4 rounded-2xl bg-indigo-50 border border-indigo-200 text-left text-xs text-indigo-900 flex items-start gap-3">
              <span class="text-base">ℹ️</span>
              <div>
                <strong class="font-bold block text-sm mb-1">Pedido registrado exitosamente (Modo Prueba)</strong>
                <p>
                  Esta orden quedó guardada con todos sus modificadores en tu base de datos y puedes visualizarla en tu panel de administración en <a href="https://adminshop.afotica.com/ordenes" target="_blank" class="underline font-bold text-indigo-700">adminshop.afotica.com/ordenes</a>.
                </p>
                <p class="mt-1 text-[11px] text-indigo-600">
                  Para cobrar pagos reales con tarjeta y SPEI vía Mercado Pago, agrega tu <code>MP_ACCESS_TOKEN</code> en el archivo <code>.env</code> de tu VPS.
                </p>
              </div>
            </div>
          )}

          <!-- Icono de Éxito -->
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 mb-6 animate-bounce">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>

          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20 mb-3">
            {isDemoMode ? 'Orden Registrada en el Sistema' : 'Pago Procesado con Éxito'}
          </span>

          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight sm:text-4xl">
            ¡Muchas gracias por tu compra!
          </h1>
          <p class="mt-3 text-base text-gray-500">
            Hemos registrado tu pedido en nuestro sistema. A continuación encontrarás el resumen detallado.
          </p>
        </>
      ) : isPending ? (
        <>
          <!-- Icono de Pendiente -->
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-amber-100 text-amber-600 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>

          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 ring-1 ring-inset ring-amber-600/20 mb-3">
            Pago Pendiente de Acreditación
          </span>

          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
            Tu orden está en proceso
          </h1>
          <p class="mt-3 text-base text-gray-500">
            Si pagaste en efectivo (ej. OXXO) o por transferencia, tu orden se confirmará tan pronto como Mercado Pago reciba el importe.
          </p>
        </>
      ) : (
        <>
          <!-- Icono de Cancelado o Error -->
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-red-100 text-red-600 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>

          <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">
            No pudimos confirmar tu pago
          </h1>
          <p class="mt-3 text-base text-gray-500">
            El proceso de pago no fue completado. No se ha realizado ningún cobro a tu cuenta.
          </p>
        </>
      )}

      <!-- Resumen de la Orden -->
      {orderId && (
        <div class="mt-8 rounded-2xl bg-gray-50 p-6 text-left border border-gray-100">
          <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-4">
            Detalles de la Transacción
          </h2>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Número de Orden:</dt>
              <dd class="font-mono text-xs font-bold text-gray-900">{orderId}</dd>
            </div>
            {paymentId && (
              <div class="flex justify-between">
                <dt class="text-gray-500">ID Mercado Pago:</dt>
                <dd class="font-mono text-xs text-gray-700">{paymentId}</dd>
              </div>
            )}
            {orderData && (
              <div class="flex justify-between border-t border-gray-200/60 pt-3">
                <dt class="font-semibold text-gray-900">Total pagado:</dt>
                <dd class="font-bold text-gray-900 text-base">
                  {currencyFormatter.format(orderData.total / 100)}
                </dd>
              </div>
            )}
          </dl>
        </div>
      )}

      <!-- Acciones de Navegación -->
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/catalogo"
          class="inline-flex items-center justify-center rounded-xl bg-gray-900 px-6 py-3.5 text-sm font-semibold text-white shadow-sm hover:bg-black transition-all active:scale-95"
        >
          Volver a la Tienda
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-6 py-3.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-all"
        >
          Ir al Inicio
        </a>
      </div>
    </div>
  </div>
</Layout>

<!-- Script para vaciar el carrito en el cliente tras pago exitoso -->
<script>
  import { clearCart } from '../store/cart';

  const params = new URLSearchParams(window.location.search);
  const status = params.get('status') || params.get('collection_status');

  if (status === 'approved' || status === 'pending') {
    // Vaciar el carrito reactivo en localStorage
    clearCart();
    console.log('✅ Carrito vaciado tras confirmación de compra.');
  }
</script>
