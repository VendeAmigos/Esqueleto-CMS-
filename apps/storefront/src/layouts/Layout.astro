---
// apps/storefront/src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import { getStoredSiteSettings } from '@esqueleto/core';

interface Props {
  title: string;
  description?: string;
}

const settings = await getStoredSiteSettings();
const { title, description = settings.heroSubtitle || 'E-commerce Open Source Plug & Play de alto rendimiento' } = Astro.props;

const headingFont = settings.headingFont || 'Plus Jakarta Sans';
const bodyFont = settings.bodyFont || 'Inter';
const uniqueFonts = Array.from(new Set([headingFont, bodyFont]));
const googleFontsUrl = `https://fonts.googleapis.com/css2?${uniqueFonts
  .map((f) => `family=${encodeURIComponent(f)}:wght@300;400;500;600;700;800`)
  .join('&')}&display=swap`;
---

<!doctype html>
<html
  lang="es"
  class="scroll-smooth"
  style={`--font-heading: '${headingFont}', system-ui, sans-serif; --font-body: '${bodyFont}', system-ui, sans-serif;`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {settings.siteName}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts Dinámicas desde el CMS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={googleFontsUrl} rel="stylesheet" />
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col antialiased">
    <!-- Barra de Navegación Global -->
    <Navbar />

    <!-- Contenido Dinámico de la Página -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pb-24 md:pb-8">
      <slot />
    </main>

    <!-- Footer Mínimo y Elegante -->
    <footer class="border-t border-gray-200 bg-white py-6 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-gray-500">
        &copy; {new Date().getFullYear()} {settings.siteName}. Todos los derechos reservados.
      </div>
    </footer>
  </body>
</html>

<style is:global>
  body {
    font-family: var(--font-body);
  }
  h1, h2, h3, h4, .font-heading {
    font-family: var(--font-heading);
  }
</style>
