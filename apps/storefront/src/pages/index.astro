---
// apps/storefront/src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bienvenido">
  <div class="relative isolate overflow-hidden rounded-3xl bg-gray-900 py-24 sm:py-32 text-center shadow-2xl">
    <div class="mx-auto max-w-2xl px-6 lg:px-8">
      <span class="inline-flex items-center rounded-full bg-indigo-500/10 px-3 py-1 text-xs font-semibold text-indigo-400 ring-1 ring-inset ring-indigo-500/20 mb-4">
        E-commerce Plug & Play Dockerizado
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl">
        Velocidad extrema. Control total en Docker.
      </h1>
      <p class="mt-6 text-lg leading-8 text-gray-300">
        Construido con Astro, PostgreSQL local con Docker y Mercado Pago. Catálogo con imágenes reales, opciones y modificadores de precio en tiempo real.
      </p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a
          href="/catalogo"
          class="rounded-xl bg-white px-6 py-3.5 text-sm font-bold text-gray-900 shadow-sm hover:bg-gray-100 transition-all active:scale-95"
        >
          Explorar Catálogo &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>
