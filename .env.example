# ==============================================================================
# 1. Identificador de Instancia (Boilerplate Multi-Tienda / Multi-POS)
# ==============================================================================
# Cambia APP_SLUG y los puertos para desplegar múltiples tiendas en el mismo VPS
APP_SLUG=esqueleto
STOREFRONT_PORT=4321
ADMIN_PORT=3001
POSTGRES_HOST_PORT=5434

# ==============================================================================
# 2. Base de Datos PostgreSQL
# ==============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
POSTGRES_DB=esqueleto
DATABASE_URL=postgres://admin:CAMBIA_ESTA_CONTRASENA_SEGURA@127.0.0.1:5432/esqueleto

# ==============================================================================
# 3. Dominios y URLs Públicas
# ==============================================================================
PUBLIC_STOREFRONT_URL=https://shop.afotica.com
PUBLIC_ADMIN_URL=https://adminshop.afotica.com
STOREFRONT_DOMAIN=shop.afotica.com
ADMIN_DOMAIN=adminshop.afotica.com
CADDY_EMAIL=admin@afotica.com

# ==============================================================================
# 4. Seguridad del Panel de Administración (CMS)
# ==============================================================================
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIA_CONTRASENA_ADMIN
ADMIN_SECRET=genera-una-llave-aleatoria-de-64-caracteres-aqui

# ==============================================================================
# 5. Pasarela de Pagos Mercado Pago (Opcional en .env: también configurable desde /pagos en el CMS)
# ==============================================================================
PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
