# Base de Datos Local en Docker (PostgreSQL)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=esqueleto
# URL de conexión (para desarrollo local usa localhost; en Docker se usa postgres)
DATABASE_URL=postgres://admin:admin123@localhost:5432/esqueleto

# Mercado Pago (Credenciales de Sandbox TEST-... o Producción APP_USR-...)
MP_ACCESS_TOKEN=

# URLs de servicios
PUBLIC_STOREFRONT_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001

# Panel de Administración (Credenciales de Acceso)
ADMIN_USER=admin
ADMIN_PASSWORD=esqueleto
